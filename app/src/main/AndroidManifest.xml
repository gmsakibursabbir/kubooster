<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- KuBooster reads only public device/display/battery state; no location,
         camera, microphone, contacts, SMS or telephony permissions are requested. -->

    <!-- Used EXCLUSIVELY to check GitHub Releases for newer versions of this app
         (api.github.com) and to download the signed APK from github.com when the
         user explicitly taps "Download update". No analytics or telemetry exist. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed so the downloaded GitHub release APK can be handed to the system
         installer. The user confirms every installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reversible, user-confirmed changes to system settings the user opts into
         (e.g. screen brightness). Granted through the system
         ACTION_MANAGE_WRITE_SETTINGS screen, never silently. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!-- Narrow package visibility: we only ever need to see PUBG Mobile variants
         to report install/version status. Nothing else is queried. -->
    <queries>
        <package android:name="com.tencent.ig" />
        <package android:name="com.tencent.igfit" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.pubg.imobile" />
    </queries>

    <application
        android:name=".KuBoosterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KuBooster">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KuBooster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku provider: required by the Shizuku API for user-side grant flow.
             Only activated when the user opens the Shizuku integration screen. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Shares downloaded release APKs with the system installer only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
